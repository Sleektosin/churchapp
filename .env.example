# Copy to .env (which is gitignored) and fill in real values.
# These were previously hardcoded in source and are exposed in git history —
# ROTATE them before relying on this app.

# Postgres connection string (required — app refuses to start without it)
DATABASE_URI=postgresql://USER:PASSWORD@HOST:5432/postgres

# Flask session signing key (use a long random value in production)
SECRET_KEY=change-me-to-a-long-random-string

# SendGrid email (optional)
SENDGRID_API_KEY=
MAIL_FROM_EMAIL=
